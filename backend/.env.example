APP_NAME=Territorio API
# Usa una base exclusiva para este proyecto.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=territorio
DB_USER=territorio_app
# Copia este archivo a .env y escribe allí tu contraseña local.
DB_PASSWORD=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Desarrollo HTTP local; usar true al publicar con HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_HOURS=8
# Activar únicamente para la aplicación piloto; los registros siempre son piloto.
PILOT_SURVEY_ENABLED=false
